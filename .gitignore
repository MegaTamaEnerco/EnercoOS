# Build and output artifacts
/dist/
/work/
*.iso
*.iso.sig
*.iso.sha256

# Archiso temporary directories
/tmp/
/work_dir/

# Local pacman repository packages (keep repository structure clean)
/localrepo/*.pkg.tar.*
/localrepo/*.db*
/localrepo/*.files*
!/localrepo/.gitkeep

# Package build artifacts in pkgs/
pkgs/*/*/
pkgs/*/src/
pkgs/*/pkg/
pkgs/*/*.tar.*
pkgs/*/*.zip
pkgs/*/*.log
!pkgs/*/PKGBUILD
!pkgs/*/*.*

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*~
*.swp

