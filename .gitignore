# Build and output artifacts
/dist/
/work/
*.iso
*.iso.sig
*.iso.sha256

# Archiso temporary directories
/tmp/
/work_dir/

# Local pacman repository packages (keep repository structure clean)
/localrepo/*.pkg.tar.*
/localrepo/*.db*
/localrepo/*.files*
!/localrepo/.gitkeep

# Package archives and build artifacts
*.pkg.tar.*
*.pkg.tar.zst
pkgs/*/src/
pkgs/*/pkg/
pkgs/*/*.pkg.tar.*
pkgs/*/*.tar.*
pkgs/*/*.zip
pkgs/*/*.log
pkgs/*/*.sig

# Cloned source repositories during local makepkg builds
pkgs/macos-like-icon-theme/macos-like/
pkgs/enerco-macshell/macshell/

# Agent and AI metadata
.agents/

# Python test artifacts
__pycache__/
*.pyc
/tests/results/

# Next.js web portal build and dependency artifacts
web/node_modules/
web/.next/
web/out/
web/logs/
web/public/downloads/*.iso
!web/public/downloads/.gitkeep
web/PRIVATE_DEPLOY_GUIDE.md
web/ecosystem.config.cjs
web/ecosystem.config.js

# Private deployment and upload scripts (server IPs and credentials)
scripts/upload-iso.ps1
scripts/upload-iso.sh
scripts/*.private.*


# Editor and OS noise
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*~
*.swp
