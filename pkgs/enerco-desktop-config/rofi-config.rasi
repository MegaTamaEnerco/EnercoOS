configuration {
    modi: "drun,run,window";
    lines: 7;
    font: "Inter 13";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "  ";
    display-run: "  ";
    display-window: "  ";
}

@theme "/dev/null"

* {
    bg: rgba(22, 28, 42, 0.88);
    bg-alt: rgba(255, 255, 255, 0.08);
    bg-selected: rgba(0, 122, 255, 0.90);
    fg: #f5f5f7;
    fg-dim: #8b949e;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 1px solid;
    border-color: @border-color;
    border-radius: 18px;
    width: 620px;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
}

prompt {
    font-weight: bold;
    font-size: 15px;
    color: #007aff;
    margin-right: 8px;
}

entry {
    font: "Inter 14";
    placeholder: "Spotlight Search";
    placeholder-color: @fg-dim;
}

listview {
    columns: 1;
    lines: 6;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    spacing: 4px;
}

element {
    orientation: horizontal;
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 12px;
}

element-icon {
    size: 28px;
}

element-text {
    vertical-align: 0.5;
    font: "Inter 13";
}

element selected {
    background-color: @bg-selected;
    color: #ffffff;
}
