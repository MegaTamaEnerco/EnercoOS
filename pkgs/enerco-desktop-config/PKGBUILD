# Maintainer: PT Mega Tama Enerco <devops@enerco.internal>
pkgname=enerco-desktop-config
pkgver=1.0.0
pkgrel=7
pkgdesc="macOS Cupertino Hyprland, Waybar, Rofi, Kitty, and SDDM configurations for EnercoOS"
arch=('any')
url="https://enerco.internal"
license=('GPL3')
depends=('hyprland' 'waybar' 'rofi' 'swaybg' 'kitty' 'dunst' 'sddm')
source=(
    "hyprland.lua"
    "hyprland.conf"
    "waybar-config.jsonc"
    "waybar-style.css"
    "rofi-config.rasi"
    "kitty.conf"
    "dunstrc"
    "sddm-enerco.conf"
    "zshrc"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    # SDDM System Configuration
    install -Dm644 "${srcdir}/sddm-enerco.conf" "${pkgdir}/etc/sddm.conf.d/10-enerco.conf"

    # User Profile Template (/etc/skel/)
    install -Dm644 "${srcdir}/hyprland.lua" "${pkgdir}/etc/skel/.config/hypr/hyprland.lua"
    install -Dm644 "${srcdir}/hyprland.conf" "${pkgdir}/etc/skel/.config/hypr/hyprland.conf"
    install -Dm644 "${srcdir}/waybar-config.jsonc" "${pkgdir}/etc/skel/.config/waybar/config.jsonc"
    install -Dm644 "${srcdir}/waybar-style.css" "${pkgdir}/etc/skel/.config/waybar/style.css"
    install -Dm644 "${srcdir}/rofi-config.rasi" "${pkgdir}/etc/skel/.config/rofi/config.rasi"
    install -Dm644 "${srcdir}/kitty.conf" "${pkgdir}/etc/skel/.config/kitty/kitty.conf"
    install -Dm644 "${srcdir}/dunstrc" "${pkgdir}/etc/skel/.config/dunst/dunstrc"
    install -Dm644 "${srcdir}/zshrc" "${pkgdir}/etc/skel/.zshrc"
}

