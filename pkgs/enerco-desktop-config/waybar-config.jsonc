[
    {
        "name": "menubar",
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 4,
        "modules-left": [
            "custom/apple-menu",
            "hyprland/window",
            "custom/menu-file",
            "custom/menu-edit",
            "custom/menu-view",
            "custom/menu-window",
            "custom/menu-help"
        ],
        "modules-center": [
            "custom/ws1",
            "custom/ws2",
            "custom/ws3",
            "custom/ws4"
        ],
        "modules-right": [
            "tray",
            "network",
            "pulseaudio",
            "battery",
            "custom/spotlight",
            "custom/control-center",
            "clock"
        ],
        "custom/apple-menu": {
            "format": "⚡ Enerco",
            "tooltip-format": "PT Mega Tama Enerco (Super+Space)",
            "on-click": "rofi -show drun"
        },
        "hyprland/window": {
            "format": "<b>{}</b>",
            "window-rewrite": {
                "class<kitty>": "Terminal",
                "class<thunar>": "Finder",
                "class<chromium>": "Safari",
                "class<calamares>": "Install EnercoOS",
                "class<pavucontrol>": "Sound Settings",
                "class<gparted>": "Disk Utility"
            },
            "window-rewrite-default": "EnercoOS Enterprise Workstation",
            "separate-outputs": true
        },
        "custom/menu-file": {
            "format": "File",
            "tooltip": false,
            "on-click": "thunar"
        },
        "custom/menu-edit": {
            "format": "Edit",
            "tooltip": false
        },
        "custom/menu-view": {
            "format": "View",
            "tooltip": false
        },
        "custom/menu-window": {
            "format": "Window",
            "tooltip": false
        },
        "custom/menu-help": {
            "format": "Help",
            "tooltip": false,
            "on-click": "/usr/local/bin/enerco-welcome"
        },
        "custom/ws1": {
            "format": "1",
            "tooltip": "Desktop 1",
            "on-click": "hyprctl dispatch workspace 1"
        },
        "custom/ws2": {
            "format": "2",
            "tooltip": "Desktop 2",
            "on-click": "hyprctl dispatch workspace 2"
        },
        "custom/ws3": {
            "format": "3",
            "tooltip": "Desktop 3",
            "on-click": "hyprctl dispatch workspace 3"
        },
        "custom/ws4": {
            "format": "4",
            "tooltip": "Desktop 4",
            "on-click": "hyprctl dispatch workspace 4"
        },
        "tray": {
            "icon-size": 14,
            "spacing": 8
        },
        "network": {
            "format-wifi": "  {essid}",
            "format-ethernet": "󰈀  {ipaddr}",
            "format-linked": "󰈀  Connected",
            "format-disconnected": "󰖪  Off",
            "tooltip-format": "Network: {ipaddr}",
            "on-click": "kitty -e nmtui"
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": " Muted",
            "format-icons": {
                "default": ["", "", ""]
            },
            "tooltip": false,
            "on-click": "pavucontrol"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-icons": ["", "", "", "", ""]
        },
        "custom/spotlight": {
            "format": "",
            "tooltip": "Spotlight (Super+Space)",
            "on-click": "rofi -show drun"
        },
        "custom/control-center": {
            "format": "",
            "tooltip": "Control Center",
            "on-click": "pavucontrol"
        },
        "clock": {
            "format": "{:%a %b %e  %I:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        }
    },
    {
        "name": "dock",
        "layer": "top",
        "position": "bottom",
        "height": 56,
        "margin-bottom": 10,
        "modules-center": [
            "custom/dock-finder",
            "custom/dock-launchpad",
            "custom/dock-browser",
            "custom/dock-terminal",
            "custom/dock-settings",
            "custom/dock-monitor",
            "custom/dock-separator",
            "custom/dock-downloads",
            "custom/dock-trash"
        ],
        "custom/dock-finder": {
            "format": "",
            "tooltip-format": "Finder",
            "on-click": "thunar"
        },
        "custom/dock-launchpad": {
            "format": "",
            "tooltip-format": "Launchpad",
            "on-click": "rofi -show drun"
        },
        "custom/dock-browser": {
            "format": "",
            "tooltip-format": "Safari / MTERP ERP",
            "on-click": "chromium --app=https://mterp.internal --ozone-platform=wayland"
        },
        "custom/dock-terminal": {
            "format": "",
            "tooltip-format": "Terminal",
            "on-click": "kitty"
        },
        "custom/dock-settings": {
            "format": "",
            "tooltip-format": "System Settings / Installer",
            "on-click": "/usr/local/bin/enerco-installer"
        },
        "custom/dock-monitor": {
            "format": "",
            "tooltip-format": "Activity Monitor",
            "on-click": "kitty -e htop"
        },
        "custom/dock-separator": {
            "format": " ",
            "tooltip": false
        },
        "custom/dock-downloads": {
            "format": "",
            "tooltip-format": "Downloads",
            "on-click": "thunar ~/Downloads"
        },
        "custom/dock-trash": {
            "format": "",
            "tooltip-format": "Trash",
            "on-click": "thunar trash:///"
        }
    }
]
