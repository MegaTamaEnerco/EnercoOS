/* ==============================================================================
 * EnercoOS macOS Control Center Popover Theme
 * Location: Top-Right under the  icon
 * ============================================================================== */

configuration {
    font: "Inter 12";
    show-icons: false;
    disable-history: true;
    hide-scrollbar: true;
}

@theme "/dev/null"

* {
    bg: rgba(22, 28, 42, 0.95);
    bg-selected: rgba(0, 122, 255, 0.90);
    fg: #f5f5f7;
    fg-dim: #8b949e;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 1px solid;
    border-color: @border-color;
    border-radius: 12px;
    width: 290px;
    location: northeast;
    anchor: northeast;
    x-offset: -8px;
    y-offset: 36px;
    padding: 6px;
}

mainbox {
    children: [ listview ];
    spacing: 0px;
}

listview {
    columns: 1;
    lines: 6;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    spacing: 2px;
}

element {
    orientation: horizontal;
    border-radius: 6px;
    padding: 7px 10px;
}

element-text {
    vertical-align: 0.5;
    font: "Inter 12";
}

element selected {
    background-color: @bg-selected;
    color: #ffffff;
}
