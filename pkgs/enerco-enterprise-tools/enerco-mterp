#!/usr/bin/env bash
# ==============================================================================
# EnercoOS MTERP Enterprise Web Application Launcher
# Launches Chromium in Wayland App Mode with isolated user profile
# ==============================================================================
set -euo pipefail

PROFILE_DIR="${HOME}/.config/mterp-profile"
mkdir -p "${PROFILE_DIR}"

exec chromium \
    --app="https://mterp.megatama-enerco.com" \
    --ozone-platform=wayland \
    --enable-features=VaapiVideoDecodeLinuxGL,VaapiVideoEncoder,CanvasOopRasterization,UseOzonePlatform \
    --enable-gpu-rasterization \
    --enable-zero-copy \
    --ignore-gpu-blocklist \
    --user-data-dir="${PROFILE_DIR}" \
    "$@"
