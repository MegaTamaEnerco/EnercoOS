#!/usr/bin/env python3
"""
EnercoOS macOS Setup Assistant & Onboarding Card
PT Mega Tama Enerco Enterprise Workstation
"""

import os
import sys
import subprocess
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk

DISABLE_FILE = os.path.expanduser("~/.config/enerco/no-welcome")

class EnercoWelcomeWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to EnercoOS")
        self.set_default_size(600, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(24)
        self.set_resizable(False)

        self.apply_styles()

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(vbox)

        # Header Title
        title_label = Gtk.Label()
        title_label.set_markup("<span font='20' weight='bold' color='#007aff'>⚡ EnercoOS Workstation</span>")
        vbox.pack_start(title_label, False, False, 0)

        # Subtitle
        sub_label = Gtk.Label()
        sub_label.set_markup("<span font='12' color='#a0aec0'>PT Mega Tama Enerco · macOS Tahoe Enterprise Edition</span>")
        vbox.pack_start(sub_label, False, False, 0)

        vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 4)

        # Intro text
        intro_label = Gtk.Label()
        intro_label.set_line_wrap(True)
        intro_label.set_markup(
            "Welcome to your enterprise workstation, featuring a modern <b>macOS Tahoe</b> glass desktop, "
            "seamless <b>MTERP ERP</b> integration, and enterprise-grade security."
        )
        vbox.pack_start(intro_label, False, False, 0)

        # Shortcuts Frame
        sc_frame = Gtk.Frame(label=" Essential macOS Shortcuts ")
        sc_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        sc_box.set_border_width(12)
        sc_frame.add(sc_box)

        shortcuts = [
            ("<b>Super + Space</b>", "Open Spotlight Search (Apps, Files, Tools)"),
            ("<b>Super + Return</b>", "Launch Kitty Terminal"),
            ("<b>Super + W / Q</b>", "Close Active Window / Quit App"),
            ("<b>Super + E</b>", "Open Finder File Manager"),
            ("<b>Super + Tab</b>", "macOS Application Switcher"),
            ("<b>Super + L</b>", "Lock Screen (hyprlock Frosted Glass)"),
            ("<b>Super + F11</b>", "Toggle 1920x1080 Full HD Display Mode"),
        ]

        for key, desc in shortcuts:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
            k_lbl = Gtk.Label()
            k_lbl.set_markup(key)
            k_lbl.set_xalign(0.0)
            k_lbl.set_size_request(140, -1)
            d_lbl = Gtk.Label()
            d_lbl.set_markup(f"<span color='#c9d1d9'>{desc}</span>")
            d_lbl.set_xalign(0.0)
            row.pack_start(k_lbl, False, False, 0)
            row.pack_start(d_lbl, True, True, 0)
            sc_box.pack_start(row, False, False, 0)

        vbox.pack_start(sc_frame, True, True, 4)

        # "Do not show on startup" Checkbox
        self.chk_disable = Gtk.CheckButton(label=" Don't show this Welcome Assistant on startup")
        self.chk_disable.set_active(os.path.exists(DISABLE_FILE))
        vbox.pack_start(self.chk_disable, False, False, 0)

        # Action Buttons Box
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        vbox.pack_start(btn_box, False, False, 6)

        # MTERP Button
        mterp_btn = Gtk.Button(label="Launch MTERP ERP")
        mterp_btn.connect("clicked", self.on_mterp_clicked)
        btn_box.pack_start(mterp_btn, True, True, 0)

        # Installer Button (if in live ISO)
        if os.path.exists("/usr/local/bin/enerco-installer"):
            inst_btn = Gtk.Button(label="Install EnercoOS (Calamares)")
            inst_btn.get_style_context().add_class("suggested-action")
            inst_btn.connect("clicked", self.on_install_clicked)
            btn_box.pack_start(inst_btn, True, True, 0)

        # Close Button
        close_btn = Gtk.Button(label="Start Working")
        close_btn.connect("clicked", self.on_close_clicked)
        btn_box.pack_start(close_btn, True, True, 0)

    def apply_styles(self):
        css_provider = Gtk.CssProvider()
        css = b"""
        window {
            background-color: #121620;
        }
        label {
            color: #f5f5f7;
            font-family: "Inter", sans-serif;
        }
        frame {
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            background: rgba(26, 32, 48, 0.65);
        }
        frame > border {
            border-radius: 10px;
        }
        checkbutton {
            color: #a0aec0;
        }
        button {
            background: rgba(255, 255, 255, 0.08);
            color: #f5f5f7;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        button:hover {
            background: rgba(255, 255, 255, 0.18);
        }
        button.suggested-action {
            background: #007aff;
            color: #ffffff;
            border: none;
        }
        button.suggested-action:hover {
            background: #0069d9;
        }
        """
        css_provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def on_install_clicked(self, widget):
        self.save_pref()
        subprocess.Popen(["/usr/local/bin/enerco-installer"])
        Gtk.main_quit()

    def on_mterp_clicked(self, widget):
        self.save_pref()
        subprocess.Popen([
            "chromium",
            "--app=https://mterp.megatama-enerco.com",
            "--ozone-platform=wayland",
            "--enable-features=UseOzonePlatform"
        ])
        Gtk.main_quit()

    def on_close_clicked(self, widget):
        self.save_pref()
        Gtk.main_quit()

    def save_pref(self):
        if self.chk_disable.get_active():
            os.makedirs(os.path.dirname(DISABLE_FILE), exist_ok=True)
            with open(DISABLE_FILE, "w") as f:
                f.write("disabled=1\n")
        else:
            if os.path.exists(DISABLE_FILE):
                os.remove(DISABLE_FILE)

if __name__ == '__main__':
    # Check if disabled by user
    if os.path.exists(DISABLE_FILE) and "--force" not in sys.argv:
        sys.exit(0)
    win = EnercoWelcomeWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
