#!/usr/bin/env python3
"""
EnercoOS Live Environment Welcome & Onboarding Dialog
"""

import sys
import subprocess
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib

class EnercoWelcomeWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="EnercoOS Enterprise Welcome")
        self.set_default_size(540, 420)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(24)
        self.set_resizable(False)

        # Apply CSS styling
        self.apply_styles()

        # Layout
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.add(vbox)

        # Header Title
        title_label = Gtk.Label()
        title_label.set_markup("<span font='18' weight='bold' color='#0071E3'>EnercoOS Workstation</span>")
        vbox.pack_start(title_label, False, False, 0)

        # Subtitle
        sub_label = Gtk.Label()
        sub_label.set_markup("<span font='11' color='#8b949e'>PT Mega Tama Enerco · Live Evaluation &amp; Installation</span>")
        vbox.pack_start(sub_label, False, False, 0)

        # Separator
        vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 8)

        # Description text
        desc_label = Gtk.Label()
        desc_label.set_line_wrap(True)
        desc_label.set_markup(
            "Welcome to the EnercoOS live desktop environment. You can test the "
            "workstation features, evaluate the <b>MTERP Enterprise Console</b>, or "
            "install EnercoOS permanently onto this computer."
        )
        vbox.pack_start(desc_label, False, False, 4)

        # Action Buttons Box
        btn_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.pack_start(btn_box, True, True, 10)

        # 1. Install EnercoOS Button (Primary)
        install_btn = Gtk.Button(label="  Install EnercoOS to Disk (Calamares)")
        install_btn.get_style_context().add_class("suggested-action")
        install_btn.connect("clicked", self.on_install_clicked)
        btn_box.pack_start(install_btn, True, True, 0)

        # 2. Launch MTERP Button
        mterp_btn = Gtk.Button(label="  Launch MTERP Management Console")
        mterp_btn.connect("clicked", self.on_mterp_clicked)
        btn_box.pack_start(mterp_btn, True, True, 0)

        # 3. Continue Live Session Button
        close_btn = Gtk.Button(label="  Evaluate Live Desktop")
        close_btn.connect("clicked", lambda w: Gtk.main_quit())
        btn_box.pack_start(close_btn, True, True, 0)

    def apply_styles(self):
        css_provider = Gtk.CssProvider()
        css = b"""
        window {
            background-color: #161b22;
        }
        label {
            color: #f0f6fc;
        }
        button {
            background: #21262d;
            color: #f0f6fc;
            border-radius: 8px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        button:hover {
            background: #30363d;
        }
        button.suggested-action {
            background: #0071e3;
            color: #ffffff;
            border: none;
        }
        button.suggested-action:hover {
            background: #0077ed;
        }
        """
        css_provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def on_install_clicked(self, widget):
        subprocess.Popen(["calamares"])
        Gtk.main_quit()

    def on_mterp_clicked(self, widget):
        subprocess.Popen([
            "chromium",
            "--app=https://mterp.internal",
            "--ozone-platform=wayland",
            "--enable-features=UseOzonePlatform"
        ])
        Gtk.main_quit()

if __name__ == '__main__':
    win = EnercoWelcomeWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

