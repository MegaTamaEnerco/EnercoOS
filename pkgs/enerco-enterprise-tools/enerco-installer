#!/usr/bin/env bash
# ==============================================================================
# EnercoOS System Installer Launcher
# Runs Calamares with root privileges under Wayland / X11
# ==============================================================================

set -e

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"

# Permit local root to connect to user's Wayland / X11 display
if command -v xhost &>/dev/null; then
    xhost +si:localuser:root 2>/dev/null || xhost + 2>/dev/null || true
fi

# Ensure Calamares unpackfs source media and airootfs.sfs paths exist
if command -v sudo &>/dev/null; then
    if [[ -x /usr/local/bin/enerco-prepare-unpackfs ]]; then
        sudo /usr/local/bin/enerco-prepare-unpackfs 2>/dev/null || true
    fi
fi

# Determine active Wayland socket (waybar/macshell/rofi may not always export WAYLAND_DISPLAY)
WL_SOCK="${WAYLAND_DISPLAY:-wayland-1}"
if [[ ! -S "${XDG_RUNTIME_DIR}/${WL_SOCK}" ]]; then
    if [[ -S "${XDG_RUNTIME_DIR}/wayland-0" ]]; then
        WL_SOCK="wayland-0"
    elif [[ -S "${XDG_RUNTIME_DIR}/wayland-1" ]]; then
        WL_SOCK="wayland-1"
    else
        for sock in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
            if [[ -S "${sock}" ]]; then
                WL_SOCK="$(basename "${sock}")"
                break
            fi
        done
    fi
fi

# Prevent duplicate Calamares instances
if pgrep -x calamares >/dev/null 2>&1; then
    hyprctl dispatch focuswindow "class:^(calamares)$" 2>/dev/null || true
    exit 0
fi

# Execute Calamares with preserved display & rendering environment
exec sudo -E env \
    WAYLAND_DISPLAY="${WL_SOCK}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    DISPLAY="${DISPLAY:-:0}" \
    QT_QPA_PLATFORM="wayland;xcb" \
    QT_WAYLAND_DISABLE_WINDOWDECORATION="1" \
    LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-}" \
    GALLIUM_DRIVER="${GALLIUM_DRIVER:-}" \
    calamares "$@" >/tmp/enerco-installer.log 2>&1
