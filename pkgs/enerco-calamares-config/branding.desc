style:
   SidebarBackground:        "#0b0e14"
   SidebarText:              "#a1a1a6"
   SidebarBackgroundCurrent: "#0071e3"
   SidebarTextCurrent:       "#ffffff"

slideshow:
    - "/usr/share/backgrounds/enerco-mac.png"
