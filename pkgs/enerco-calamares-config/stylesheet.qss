/* ==============================================================================
 * Calamares macOS Tahoe Dark Glass Qt Stylesheet for EnercoOS
 * ============================================================================== */

QWidget {
    background-color: #12151c;
    color: #f5f5f7;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 10pt;
}

QDialog {
    background-color: #161b26;
}

/* Suppress all scrollbars across Calamares completely */
QScrollBar:horizontal {
    height: 0px !important;
    min-height: 0px !important;
    max-height: 0px !important;
    border: none !important;
    background: transparent !important;
}

QScrollBar:vertical {
    width: 0px !important;
    min-width: 0px !important;
    max-width: 0px !important;
    border: none !important;
    background: transparent !important;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::add-line:vertical,
QScrollBar::sub-line:horizontal,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:horizontal,
QScrollBar::sub-page:vertical {
    width: 0px !important;
    height: 0px !important;
    border: none !important;
    background: transparent !important;
}

/* Sidebar Container */
#sidebarApp {
    background-color: #0b0e14;
    min-width: 175px;
    max-width: 175px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
}

/* Sidebar Logo */
#logoApp {
    padding: 12px 0px 6px 0px;
    max-height: 44px;
    qproperty-alignment: AlignCenter;
}

/* Sidebar Step List */
#sidebarMenuApp,
#sidebarApp QTreeView,
#sidebarApp QListView {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: 9.5pt;
    font-weight: 500;
    qproperty-rootIsDecorated: false;
    qproperty-indentation: 0;
}

#sidebarMenuApp::item,
#sidebarApp QTreeView::item,
#sidebarApp QListView::item {
    padding: 6px 12px;
    border-radius: 6px;
    margin: 2px 6px;
    color: #86868b;
}

#sidebarMenuApp::item:selected,
#sidebarApp QTreeView::item:selected,
#sidebarApp QListView::item:selected {
    background-color: #0071e3;
    color: #ffffff;
    font-weight: 600;
}

/* Sidebar Bottom Buttons */
#aboutButton {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 4px 10px;
    margin: 8px 14px;
    font-size: 8.5pt;
    color: #86868b;
    max-width: 76px;
}

#aboutButton:hover {
    background-color: rgba(255, 255, 255, 0.14);
    color: #ffffff;
}

#debugButton {
    max-width: 0px !important;
    max-height: 0px !important;
    min-width: 0px !important;
    min-height: 0px !important;
    padding: 0px !important;
    margin: 0px !important;
    border: none !important;
    qproperty-visible: false;
}

/* Tables and Tree Views */
QTreeView, QTableView {
    background-color: #181c24;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
}

/* Buttons (macOS Rounded Glass) */
QPushButton {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 7px 18px;
    color: #f5f5f7;
    font-weight: 500;
    min-height: 18px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.2);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.25);
}

QPushButton:default,
QPushButton#nextButton {
    background-color: #0071e3;
    border: 1px solid #0077ed;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover,
QPushButton#nextButton:hover {
    background-color: #0077ed;
}

QPushButton#backButton {
    background-color: rgba(255, 255, 255, 0.08);
    color: #f5f5f7;
}

QPushButton#cancelButton {
    background-color: rgba(255, 255, 255, 0.05);
    color: #86868b;
}

QPushButton#cancelButton:hover {
    background-color: rgba(255, 69, 58, 0.15);
    border-color: rgba(255, 69, 58, 0.3);
    color: #ff453a;
}

/* Input Fields */
QLineEdit, QComboBox {
    background-color: #181c24;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 7px 12px;
    color: #f5f5f7;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    text-align: center;
    background-color: #181c24;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #0071e3;
    border-radius: 7px;
}
