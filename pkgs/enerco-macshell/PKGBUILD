# Maintainer: PT Mega Tama Enerco <devops@megatama-enerco.com>
pkgname=enerco-macshell
pkgver=1.0.0
pkgrel=2
pkgdesc="macOS Tahoe Liquid Glass Desktop Shell for EnercoOS (MacShell + MacLock)"
arch=('any')
url="https://github.com/0-ss/MacShell"
license=('GPL3')
options=('!strip' '!debug')
depends=(
    'quickshell'
    'qt6-multimedia'
    'qt6-multimedia-ffmpeg'
    'qt6-shadertools'
    'upower'
    'playerctl'
    'hypridle'
    'python-pillow'
    'librsvg'
    'macos-like-icon-theme'
)
makedepends=(
    'git'
)
source=(
    "macshell::git+https://github.com/0-ss/MacShell.git#commit=51db0bab6997da310d2aacfaa7084740ec44ad4a"
    "macshell-start"
    "maclock"
    "pinned.json"
    "settings-dock.json"
    "settings-bar.json"
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

package() {
    # System-wide Quickshell configs
    install -dm755 "${pkgdir}/etc/xdg/quickshell"
    cp -dr --no-preserve=ownership "${srcdir}/macshell/MacShell" "${pkgdir}/etc/xdg/quickshell/"
    cp -dr --no-preserve=ownership "${srcdir}/macshell/MacLock" "${pkgdir}/etc/xdg/quickshell/"

    # Install user skel default links/configs
    install -dm755 "${pkgdir}/etc/skel/.config/quickshell"
    cp -dr --no-preserve=ownership "${srcdir}/macshell/MacShell" "${pkgdir}/etc/skel/.config/quickshell/"
    cp -dr --no-preserve=ownership "${srcdir}/macshell/MacLock" "${pkgdir}/etc/skel/.config/quickshell/"

    # Pre-configured dock and bar settings
    install -Dm644 "${srcdir}/pinned.json" "${pkgdir}/etc/skel/.config/macdock/pinned.json"
    install -Dm644 "${srcdir}/settings-dock.json" "${pkgdir}/etc/skel/.config/macdock/settings.json"
    install -Dm644 "${srcdir}/settings-bar.json" "${pkgdir}/etc/skel/.config/macbar/settings.json"

    # Fonts
    install -dm755 "${pkgdir}/usr/share/fonts/OTF"
    if [ -d "${srcdir}/macshell/MacShell/assets/fonts" ]; then
        install -Dm644 "${srcdir}/macshell/MacShell/assets/fonts"/*.otf "${pkgdir}/usr/share/fonts/OTF/" 2>/dev/null || true
    fi

    # Supervisor & Lock Scripts
    install -D -m 755 "${srcdir}/macshell-start" "${pkgdir}/usr/local/bin/macshell-start"
    install -D -m 755 "${srcdir}/maclock" "${pkgdir}/usr/local/bin/maclock"
}
