# Enforce LF line endings for Archiso Linux scripts and configuration files
* text=auto eol=lf

# Build scripts, presets, and specifications
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.preset text eol=lf
*.cfg text eol=lf
*.desc text eol=lf
*.desktop text eol=lf
profiledef.sh text eol=lf
packages.x86_64 text eol=lf
PKGBUILD text eol=lf
pacman.conf text eol=lf

# Desktop & styling configs
*.lua text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.rasi text eol=lf
*.css text eol=lf
*.qss text eol=lf

# System files in airootfs
airootfs/etc/* text eol=lf
airootfs/etc/**/* text eol=lf
airootfs/usr/* text eol=lf
airootfs/usr/**/* text eol=lf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg text eol=lf

