#!/usr/bin/env bash
# ==============================================================================
# EnercoOS macOS Control Center Trigger
# ==============================================================================
set -euo pipefail

MENU_THEME="/etc/skel/.config/rofi/control-center.rasi"
if [[ -f "${HOME}/.config/rofi/control-center.rasi" ]]; then
    MENU_THEME="${HOME}/.config/rofi/control-center.rasi"
fi

CHOICE=$(printf "   Sound & Volume Settings...\n   Network Connections (WiFi/LAN)...\n🖥️  Set Display: 1920x1080 (1080p)\n🖥️  Set Display: 1366x768 (768p)\n🔒  Lock Workstation (hyprlock)\n🛡️  Enterprise Security Status" | rofi -dmenu -theme "${MENU_THEME}" -p "Control Center" || true)

case "${CHOICE}" in
    *"Sound & Volume"*)
        pavucontrol &
        ;;
    *"Network Connections"*)
        kitty -e nmtui &
        ;;
    *"1920x1080"*)
        hyprctl keyword monitor ",1920x1080@60,auto,1"
        ;;
    *"1366x768"*)
        hyprctl keyword monitor ",1366x768@60,auto,1"
        ;;
    *"Lock Workstation"*)
        hyprlock &
        ;;
    *"Enterprise Security"*)
        kitty -e bash -c "sudo ufw status verbose; echo ''; fastfetch; echo 'Press Enter to close'; read" &
        ;;
esac
