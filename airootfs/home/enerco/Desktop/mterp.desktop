[Desktop Entry]
Name=MTERP Console
GenericName=Enterprise Resource Planning
Comment=PT Mega Tama Enerco Management Interface
Exec=chromium --app=https://mterp.internal --ozone-platform=wayland --enable-features=UseOzonePlatform --user-data-dir=%h/.config/mterp-profile
Icon=enerco-logo
Terminal=false
Type=Application
Categories=Office;Finance;Network;
StartupNotify=true
StartupWMClass=mterp.internal

