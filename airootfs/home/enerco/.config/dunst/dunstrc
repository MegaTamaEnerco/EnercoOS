[global]
    font = "Noto Sans 11"
    allow_markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "360x6-24+50"
    transparency = 15
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    line_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 16
    separator_color = frame
    startup_notification = false
    corner_radius = 12

[urgency_low]
    background = "#161b22"
    foreground = "#8b949e"
    frame_color = "#30363d"
    timeout = 4

[urgency_normal]
    background = "#161b22"
    foreground = "#f0f6fc"
    frame_color = "#0071e3"
    timeout = 6

[urgency_critical]
    background = "#161b22"
    foreground = "#ff7b72"
    frame_color = "#f85149"
    timeout = 0

