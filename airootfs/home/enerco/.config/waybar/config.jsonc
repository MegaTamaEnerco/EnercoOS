// ==============================================================================
// EnercoOS macOS Tahoe Dual-Bar Architecture
// Top Menubar (30px) + Floating Bottom Dock (56px)
// ==============================================================================
[
    {
        "name": "menubar",
        "layer": "top",
        "position": "top",
        "height": 30,
        "exclusive": true,
        "passthrough": false,
        "modules-left": [
            "custom/apple-menu",
            "custom/active-app",
            "custom/menu-file",
            "custom/menu-edit",
            "custom/menu-view",
            "custom/menu-window",
            "custom/menu-help"
        ],
        "modules-center": [
            "custom/ws1",
            "custom/ws2",
            "custom/ws3",
            "custom/ws4"
        ],
        "modules-right": [
            "tray",
            "network",
            "pulseaudio",
            "battery",
            "custom/spotlight",
            "custom/control-center",
            "clock"
        ],
        "custom/apple-menu": {
            "format": "   ",
            "tooltip-format": "Apple System Menu",
            "on-click": "/usr/local/bin/enerco-menubar apple"
        },
        "custom/active-app": {
            "format": "<b>Finder</b>",
            "tooltip-format": "Finder Application Menu",
            "on-click": "/usr/local/bin/enerco-menubar finder"
        },
        "custom/menu-file": {
            "format": "File",
            "tooltip-format": "File Menu",
            "on-click": "/usr/local/bin/enerco-menubar file"
        },
        "custom/menu-edit": {
            "format": "Edit",
            "tooltip-format": "Edit Menu",
            "on-click": "/usr/local/bin/enerco-menubar edit"
        },
        "custom/menu-view": {
            "format": "View",
            "tooltip-format": "View Menu",
            "on-click": "/usr/local/bin/enerco-menubar view"
        },
        "custom/menu-window": {
            "format": "Window",
            "tooltip-format": "Window Menu",
            "on-click": "/usr/local/bin/enerco-menubar window"
        },
        "custom/menu-help": {
            "format": "Help",
            "tooltip-format": "Help Menu",
            "on-click": "/usr/local/bin/enerco-menubar help"
        },
        "custom/ws1": {
            "format": " 1 ",
            "tooltip": "Desktop 1",
            "on-click": "hyprctl dispatch workspace 1"
        },
        "custom/ws2": {
            "format": " 2 ",
            "tooltip": "Desktop 2",
            "on-click": "hyprctl dispatch workspace 2"
        },
        "custom/ws3": {
            "format": " 3 ",
            "tooltip": "Desktop 3",
            "on-click": "hyprctl dispatch workspace 3"
        },
        "custom/ws4": {
            "format": " 4 ",
            "tooltip": "Desktop 4",
            "on-click": "hyprctl dispatch workspace 4"
        },
        "tray": {
            "icon-size": 15,
            "spacing": 10
        },
        "network": {
            "format-wifi": "",
            "format-ethernet": "󰈀",
            "format-disconnected": "󰤮",
            "tooltip-format": "{ifname}: {ipaddr}",
            "on-click": "nm-connection-editor"
        },
        "pulseaudio": {
            "format": "{icon}",
            "format-muted": "󰝟",
            "format-icons": {
                "default": ["", "", ""]
            },
            "on-click": "pavucontrol"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}%",
            "format-charging": " {capacity}%",
            "format-icons": ["", "", "", "", ""]
        },
        "custom/spotlight": {
            "format": "",
            "tooltip": "Spotlight Search (Super+Space)",
            "on-click": "rofi -show drun"
        },
        "custom/control-center": {
            "format": "",
            "tooltip": "Control Center",
            "on-click": "/usr/local/bin/enerco-control-center"
        },
        "clock": {
            "format": "{:%a %b %e  %I:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        }
    },
    {
        "name": "dock",
        "layer": "top",
        "position": "bottom",
        "exclusive": true,
        "passthrough": false,
        "height": 56,
        "margin-bottom": 10,
        "modules-center": [
            "custom/dock-finder",
            "custom/dock-launchpad",
            "custom/dock-browser",
            "custom/dock-terminal",
            "custom/dock-settings",
            "custom/dock-monitor",
            "custom/dock-separator",
            "custom/dock-downloads",
            "custom/dock-trash"
        ],
        "custom/dock-finder": {
            "format": "",
            "tooltip-format": "Finder",
            "on-click": "/usr/local/bin/enerco-dock-launch thunar thunar"
        },
        "custom/dock-launchpad": {
            "format": "",
            "tooltip-format": "Launchpad",
            "on-click": "rofi -show drun"
        },
        "custom/dock-browser": {
            "format": "",
            "tooltip-format": "Safari / MTERP ERP",
            "on-click": "/usr/local/bin/enerco-dock-launch chromium chromium --app=https://mterp.megatama-enerco.com --ozone-platform=wayland --enable-features=VaapiVideoDecodeLinuxGL,VaapiVideoEncoder,CanvasOopRasterization,UseOzonePlatform --enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist"
        },
        "custom/dock-terminal": {
            "format": "",
            "tooltip-format": "Terminal",
            "on-click": "/usr/local/bin/enerco-dock-launch kitty kitty"
        },
        "custom/dock-settings": {
            "format": "",
            "tooltip-format": "System Settings / Installer",
            "on-click": "/usr/local/bin/enerco-dock-launch calamares /usr/local/bin/enerco-installer"
        },
        "custom/dock-monitor": {
            "format": "",
            "tooltip-format": "Activity Monitor",
            "on-click": "/usr/local/bin/enerco-dock-launch kitty kitty -e htop"
        },
        "custom/dock-separator": {
            "format": " ",
            "tooltip": false
        },
        "custom/dock-downloads": {
            "format": "",
            "tooltip-format": "Downloads",
            "on-click": "/usr/local/bin/enerco-dock-launch thunar thunar ~/Downloads"
        },
        "custom/dock-trash": {
            "format": "",
            "tooltip-format": "Trash",
            "on-click": "/usr/local/bin/enerco-dock-launch thunar thunar trash:///"
        }
    }
]
